          <mxGeometry x="380" y="1060" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- ================= infrastructure ================= -->
        <mxCell id="json_repo" value="&lt;b&gt;JsonGameRepository&lt;/b&gt;&lt;hr&gt;- path: Path&lt;hr&gt;+ __init__(path: Path)&lt;br/&gt;+ get_all(): list[Game]&lt;br/&gt;+ save_all(games): None&lt;br/&gt;- _game_from_dict(d): Game&lt;br/&gt;- _game_to_dict(g): dict"
                style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;"
                vertex="1" parent="1">
          <mxGeometry x="380" y="800" width="240" height="200" as="geometry"/>
        </mxCell>

