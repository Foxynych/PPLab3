          <mxGeometry x="60" y="540" width="200" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="repo" value="&lt;b&gt;GameRepository&lt;/b&gt;&lt;br/&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;hr&gt;+ get_all(): list[Game]&lt;br/&gt;+ save_all(games): None"
