          <mxGeometry x="60" y="800" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- exceptions -->
        <mxCell id="ms_error" value="&lt;b&gt;MinesweeperError&lt;/b&gt;&lt;br/&gt;&lt;i&gt;«exception»&lt;/i&gt;"
